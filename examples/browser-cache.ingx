    "title": "How browsers decide to use cached HTTP responses",
    "kind": "live",
    "rootId": "root",
    "explorations": {
      "root": {
        "id": "root",
        "title": "How browsers decide to use cached HTTP responses",
        "summary": "Browsers reuse fresh cache directly, then use ETag revalidation with 304 responses when stale.",
        "parentId": null,
        "source": null,
        "messages": [
          {
            "id": "question-smoke-f094a2f1-2b36-4614-84ae-dc8919ce878f",
            "role": "user",
            "requestId": "smoke-f094a2f1-2b36-4614-84ae-dc8919ce878f",
            "source": null,
            "sections": [
              {
                "id": "prompt-smoke-f094a2f1-2b36-4614-84ae-dc8919ce878f",
                "title": "",
                "body": "Explain how a browser decides whether to use a cached HTTP response. Cover freshness, Cache-Control, ETag revalidation, and one small example."
              }
            ]
          },
          {
            "id": "answer-smoke-f094a2f1-2b36-4614-84ae-dc8919ce878f",
            "role": "assistant",
            "requestId": "smoke-f094a2f1-2b36-4614-84ae-dc8919ce878f",
            "source": null,
            "routing": {
              "decision": "continue",
              "reason": "First answer in this empty topic, so it continues the main conversation."
            },
            "model": "muse-spark-1.3",
            "context": {
              "fullIds": [
                "root"

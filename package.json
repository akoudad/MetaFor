{
  "name": "metafor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "desktop:build": "node desktop/build.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --mac dir --arm64",
    "desktop:dmg": "npm run desktop:build && electron-builder --mac dmg --arm64",
    "desktop:test": "tsx --test desktop/tests/*.test.ts desktop/tests/*.test.tsx"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "three": "0.187.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "main": "desktop-dist/main.cjs",
  "build": {
    "appId": "com.akoudad.metafor",
    "productName": "Metafor",
    "directories": {
      "app": "desktop-dist",
      "output": "artifacts/mac"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "native/*",
      "assets/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "native/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "desktop/assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "desktop/entitlements.plist",
      "entitlementsInherit": "desktop/entitlements.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Metafor Help captures your current display when invoked and when you ask a question. Each question shares its screen snapshot with your configured AI provider. Selecting a region is optional."
      },
      "binaries": [
        "Contents/Resources/app.asar.unpacked/native/source-info",
        "Contents/Resources/app.asar.unpacked/native/guidance-observer"
      ]
    },
    "dmg": {
      "title": "Metafor",
      "contents": [
        {
          "x": 145,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false
  }
}
